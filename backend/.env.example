# Copy to backend/.env and fill in real values. Never commit .env.
# Every variable here is validated at startup by src/config/env.ts;
# the server refuses to start if one is missing or malformed.

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────
# Connection strings contain a password: treat the whole string as a secret.
# Use a local Postgres or two Neon databases. In production, use the pooled
# connection string from the Neon dashboard.
# TEST_DATABASE_URL is wiped on every test run: never point it at real data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership_test?schema=public

# ── Auth ─────────────────────────────────────────────────────
# Generate a long random secret (do not reuse it across environments):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
# bcrypt work factor: 10-12 in production, 4 keeps tests fast.
BCRYPT_COST=10

# ── HTTP ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcard).
CORS_ORIGIN=http://localhost:5173
# Login attempts allowed per IP per window (15 minutes).
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=900000

# ── Seed (used once by prisma/seed.ts to create the first admin) ──
ADMIN_EMAIL=admin@dealership.dev
ADMIN_PASSWORD=replace-with-a-strong-password
