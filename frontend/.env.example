# Copy to frontend/.env.local for local development.
#
# WARNING: every VITE_ variable is inlined into the JavaScript bundle at
# build time and is readable by anyone who opens the site. Never put a
# secret, API key or token here. Only public configuration belongs in this file.

# Base URL of the backend API, including the /api prefix.
VITE_API_URL=http://localhost:4000/api
