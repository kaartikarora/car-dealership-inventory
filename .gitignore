# ─────────────────────────────────────────────────────────────
# Root .gitignore for the car-dealership-inventory monorepo.
# Covers backend/ and frontend/ (patterns without a leading
# slash match at any depth).
# ─────────────────────────────────────────────────────────────

# ── Secrets and environment files ────────────────────────────
# Real values (JWT secret, DB connection strings, API keys,
# admin seed password) live only in these files or in the
# hosting dashboards. Only the .example templates are committed.
.env
.env.*
!.env.example
*.env
secrets/
*.secret
*.secrets

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output and generated code ──────────────────────────
dist/
build/
# Prisma 7 client, regenerated by `npx prisma generate`
src/generated/
*.tsbuildinfo
.vite/

# ── Tests and coverage ───────────────────────────────────────
coverage/
.nyc_output/
junit.xml
playwright-report/
test-results/

# ── Local databases and dumps (may contain real data) ────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
pgdata/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Caches ───────────────────────────────────────────────────
.eslintcache
.cache/
.turbo/

# ── Hosting CLIs (can hold project tokens) ───────────────────
.vercel/
.netlify/

# ── Editors and OS ───────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
*.swp
.DS_Store
Thumbs.db

# Note: prisma/migrations/ is deliberately NOT ignored.
# Migrations are source code and must be committed.
